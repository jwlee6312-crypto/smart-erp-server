[global]
type=global
keep_alive_interval=20
endpoint_identifier_order=ip,username,anonymous

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060

[transport-tcp]
type=transport
protocol=tcp
bind=0.0.0.0:5060

; --- Twilio Trunk (Wait for Foundation First) ---
[twilio-trunk]
type=endpoint
transport=transport-udp
context=incoming-main
disallow=all
allow=ulaw
aors=twilio-trunk
from_user=+12345163374
from_domain=crm-bank-erp.pstn.tokyo.twilio.com
rtp_timeout=20
rtp_timeout_hold=40

[twilio-trunk]
type=aor
contact=sip:crm-bank-erp.pstn.tokyo.twilio.com

; --- Extension 101 (Laptop) ---
[101]
type=aor
max_contacts=1
qualify_frequency=15

[101-auth]
type=auth
auth_type=userpass
username=101
password=101password

[101]
type=endpoint
context=from-internal
disallow=all
allow=ulaw
auth=101-auth
aors=101
force_rport=yes
rewrite_contact=yes
rtp_symmetric=yes
direct_media=no
rtp_timeout=20
rtp_timeout_hold=40
timers=yes
timers_sess_expires=90

; --- Extension 103 (Mobile) ---
[103]
type=aor
max_contacts=1
qualify_frequency=15

[103-auth]
type=auth
auth_type=userpass
username=103
password=103password

[103]
type=endpoint
context=from-internal
disallow=all
allow=ulaw
auth=103-auth
aors=103
force_rport=yes
rewrite_contact=yes
rtp_symmetric=yes
direct_media=no
rtp_timeout=20
rtp_timeout_hold=40
timers=yes
timers_sess_expires=90
