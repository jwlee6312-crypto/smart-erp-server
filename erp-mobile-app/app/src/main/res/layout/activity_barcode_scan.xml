<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 1. 카메라 실시간 미리보기 -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 1-2. 문서/이미지 선택 시 화면 미리보기 ImageView -->
    <ImageView
        android:id="@+id/ivDocPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:background="#000000"
        android:contentDescription="Document Preview" />

    <!-- 2. 초정밀 산업용 슬림 바코드 조준 프레임 (290dp x 70dp - 상하 폭 최소화) -->
    <View
        android:id="@+id/viewFinder"
        android:layout_width="290dp"
        android:layout_height="70dp"
        android:background="@drawable/bg_barcode_frame"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2-1. 정밀 조준 네온 빨간색 레이저 가이드 선 -->
    <View
        android:id="@+id/laserLine"
        android:layout_width="270dp"
        android:layout_height="2dp"
        android:background="#FF1744"
        app:layout_constraintBottom_toBottomOf="@id/viewFinder"
        app:layout_constraintEnd_toEndOf="@id/viewFinder"
        app:layout_constraintStart_toStartOf="@id/viewFinder"
        app:layout_constraintTop_toTopOf="@id/viewFinder" />

    <!-- 2-2. 안내 가이드 배지 -->
    <TextView
        android:id="@+id/tvScanGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="70dp"
        android:background="@drawable/bg_button_gradient"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="바코드를 조준창에 맞추고 아래 [스캔하기] 버튼을 누르세요"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2-3. 감지된 바코드 번호 실시간 바인딩 배지 -->
    <TextView
        android:id="@+id/tvDetectedBarcode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="#E000E5FF"
        android:paddingHorizontal="18dp"
        android:paddingVertical="8dp"
        android:text="바코드 감지 대기 중..."
        android:textColor="#000000"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/btnTriggerScan"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 2-4. 수동 스캔 확정 클릭 버튼 -->
    <Button
        android:id="@+id/btnTriggerScan"
        android:layout_width="220dp"
        android:layout_height="50dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#00E676"
        android:text="📸 바코드 스캔하기 (클릭)"
        android:textColor="#000000"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/llBottomControls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 3. 하단 컨트롤 버튼 -->
    <LinearLayout
        android:id="@+id/llBottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnGallery"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="20dp"
            android:backgroundTint="#005A9F"
            android:text="이미지/파일 선택"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnClose"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:backgroundTint="#E53935"
            android:text="닫기"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
